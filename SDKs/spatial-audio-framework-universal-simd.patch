diff --git a/framework/CMakeLists.txt b/framework/CMakeLists.txt
index 5ee2fc7af..3752da54a 100644
--- a/framework/CMakeLists.txt
+++ b/framework/CMakeLists.txt
@@ -39,9 +39,20 @@ message("
 # Configure SAF
 message(STATUS "Configuring the Spatial_Audio_Framework (SAF):")
 
-if(SAF_ENABLE_SIMD) # before declaring project, set compilation flags for SIMD support
-    set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS}   -march=native" CACHE STRING "Default C options"   FORCE)
-    set(CMAKE_C_FLAGS   "${CMAKE_CXX_FLAGS} -march=native" CACHE STRING "Default CXX options" FORCE)
+if(SAF_ENABLE_SIMD)
+    if(APPLE)
+        # This framework is always built as a universal arm64+x86_64 binary on
+        # macOS (see CMAKE_OSX_ARCHITECTURES below). A single "-march=native"
+        # targets only the host CPU and breaks compilation of whichever slice
+        # isn't the host architecture, so pass per-arch baselines instead.
+        # SHELL: keeps each -Xarch_<arch> paired with the flag that follows it
+        # -- without it, CMake can reorder/deduplicate compile options (most
+        # visibly for anything it recognises as a -D define, see below) and
+        # break that pairing.
+        set(_saf_simd_flags "SHELL:-Xarch_arm64 -march=armv8-a+fp+simd" "SHELL:-Xarch_x86_64 -march=nehalem")
+    else()
+        set(_saf_simd_flags -march=native)
+    endif()
 endif()
 
 project(saf VERSION ${SAF_VERSION} LANGUAGES C)
@@ -49,9 +60,18 @@ add_library(${PROJECT_NAME}) #STATIC
 set_target_properties(${PROJECT_NAME}
 PROPERTIES
     VERSION ${PROJECT_VERSION}
-    SOVERSION ${PROJECT_VERSION} 
+    SOVERSION ${PROJECT_VERSION}
 )
 
+if(SAF_ENABLE_SIMD)
+    # Scoped to this target (not the global CMAKE_C_FLAGS/CXX_FLAGS) so these
+    # arch-specific flags don't leak into other targets in the build -- e.g. a
+    # single-arch consumer would otherwise get a harmless but noisy
+    # "argument unused during compilation" warning for the -Xarch_* flag that
+    # doesn't match its own target arch.
+    target_compile_options(${PROJECT_NAME} PRIVATE ${_saf_simd_flags})
+endif()
+
 # Display system and configuration info
 message(STATUS "${CMAKE_SYSTEM_INFO_FILE}, name: ${CMAKE_SYSTEM_NAME}, arch: ${CMAKE_SYSTEM_PROCESSOR}, sys: ${CMAKE_SYSTEM}")
 if(BUILD_SHARED_LIBS)
@@ -270,9 +290,25 @@ endif()
 ############################################################################
 # Enable SIMD intrinsics
 if(SAF_ENABLE_SIMD)
-    # Note: appropriate compiler flags were previously added before declaration of project 
+    # Note: appropriate compiler flags were previously added before declaration of project
     message(STATUS "SIMD intrinsics support is enabled.")
-    target_compile_definitions(${PROJECT_NAME} PUBLIC SAF_ENABLE_SIMD=1)
+    # PRIVATE: SAF_ENABLE_SIMD only affects framework/include/saf_externals.h,
+    # which is pulled in solely by this library's own internal .c files (not
+    # by the public saf.h consumers include), so it need not -- and, for a
+    # single-arch consumer of a universal SAF build, must not -- propagate as
+    # a usage requirement. PUBLIC previously leaked the -Xarch_x86_64 flag
+    # into every target linking against saf, producing a harmless but noisy
+    # "argument unused during compilation" warning on targets not built for
+    # x86_64.
+    if(APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES "arm64" AND CMAKE_OSX_ARCHITECTURES MATCHES "x86_64")
+        # This SIMD fallback path only has x86 (SSE/AVX) intrinsics implemented
+        # -- there is no NEON equivalent -- so in a universal build it can only
+        # be enabled for the x86_64 slice. The arm64 slice already gets
+        # vectorised linear algebra from Apple Accelerate regardless.
+        target_compile_options(${PROJECT_NAME} PRIVATE "SHELL:-Xarch_x86_64 -DSAF_ENABLE_SIMD=1")
+    else()
+        target_compile_definitions(${PROJECT_NAME} PRIVATE SAF_ENABLE_SIMD=1)
+    endif()
 endif()
 
 ############################################################################
